# ============================================
# SISTEMMA BACKEND — variáveis de ambiente
# ============================================
# Copie para .env e ajuste os valores. Não commite o .env.

# ─── Servidor ───
PORT=3200
APP_PORT=3200
NODE_ENV=development
NODE_OPTIONS=--max-old-space-size=768
PUBLIC_BASE_URL=
RENDER_EXTERNAL_URL=
BUILD_SHA=
IMAGE_TAG=
TAG=

# ─── PostgreSQL ───
# Se DATABASE_URL existir, ela tem prioridade (SSL rejectUnauthorized=false).
# DATABASE_SSL=false desliga o SSL dessa URL (útil na rede interna da Render).
DATABASE_URL=
DATABASE_SSL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=neurai
DATABASE_PASSWORD=altere_esta_senha
DATABASE_NAME=abastecimento
TYPEORM_SYNCHRONIZE=false
MULTI_TENANT=false
CONTROL_DATABASE_NAME=
DB_POOL_MAX=8
DB_POOL_IDLE_MS=10000
DB_POOL_CONNECT_MS=20000
DB_STATEMENT_TIMEOUT_MS=120000
DB_LOG_SLOW_MS=0

# ─── JWT (obrigatório em produção) ───
JWT_SECRET=sua_chave_secreta_min_32_caracteres_aqui
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=refresh_secret_super_seguro
JWT_REFRESH_EXPIRY=30d

# ─── CORS ───
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175,http://localhost:3300,http://127.0.0.1:3300
CORS_CREDENTIALS=true

# ─── Armazenamento ───
# STORAGE_DRIVER=postgres grava na tabela arquivos_storage.
# Vazio: MinIO se MINIO_ENDPOINT existir, senão disco local (./uploads).
STORAGE_DRIVER=
# Sem MINIO_ENDPOINT o backend grava em ./uploads e avisa no log.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=abastecimentos
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=

# ─── PDF (Puppeteer) ───
PUPPETEER_CACHE_DIR=./.cache/puppeteer
PUPPETEER_EXECUTABLE_PATH=
PDF_MANTER_NAVEGADOR=false

# ─── OCR Python (opcional) ───
PYTHON_OCR_API_URL=http://localhost:8000
OCR_FALLBACK_PYTHON=true
# LOCALAPPDATA é do Windows e só serve para achar Chrome/Edge instalados. Não defina na Render.

# ─── Autenticação ───
ALLOW_PUBLIC_REGISTER=false
# POST /api/auth/acesso-direto. Só liga com true. Vazio, false ou ausente deixa desligado.
ACESSO_LIVRE=false

# ─── WhatsApp Cloud API (Meta — opcional) ───
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_INBOX_DIR=
WHATSAPP_RETOMADA_MS=20000
TEMP_DIR=./temp

# ─── WuzAPI ───
WUZAPI_URL=
WUZAPI_TOKEN=
WUZAPI_ADMIN_TOKEN=
# URL pública com o mesmo valor de WUZAPI_WEBHOOK_SECRET na query secret.
WUZAPI_WEBHOOK_URL=
WUZAPI_WEBHOOK_SECRET=
WUZAPI_WEBHOOK_HMAC_KEY=
WUZAPI_GLOBAL_HMAC_KEY=
WUZAPI_WEBHOOK_ENFORCE=false
WUZAPI_WEBHOOK_BODY_LIMIT=64mb
WUZAPI_TIMEOUT_MS=120000
WUZAPI_DOWNLOAD_TIMEOUT_MS=300000
WUZAPI_INSTANCE_NAME=Sistemma
WUZAPI_VIGIA_MS=60000
WEBHOOK_URL=

# ─── ManuControl (opcional) ───
MANU_WEBHOOK_URL=
MANU_CHATBOT_SECRET=

# ─── Sala técnica (opcional) ───
SALA_TECNICA_URL=
SALA_TECNICA_SECRET=
CHATBOT_API_SECRET=

# ─── Upload e cache de API ───
MAX_FILE_SIZE=10485760
GRAFICOS_DADOS_LIMITE=20000
DADOS_CACHE_TTL_MS=120000
DADOS_CACHE_MAX_ENTRADAS=12
DADOS_CACHE_MAX_LINHAS=60000
KPIS_CONSOLIDADO_CONCURRENCY=2
KPIS_CONSOLIDADO_LIMITE=8
ENDPOINTS_PESADOS_CONCURRENCY=2
PDF_CACHE_MAX_ENTRADAS=5
ENDPOINT_CACHE_TTL_MS=21600000
ENDPOINT_CACHE_MAX=200

# ─── Boot ───
SKIP_STARTUP_SEED=false
SKIP_STARTUP_MIGRATIONS=false
SYNC_KPIS_UNIVERSAIS=true

# ─── Disco relativo ───
PLANILHAS_BACKUP_HOST_DIR=planilhas-ciclo
DASHBOARD_CACHE_DIR=
DASHBOARD_CACHE_DISCO=true
DASHBOARD_EXECUTIVO_CACHE_TTL_MS=86400000

# ─── Cache Dashboard Executivo ───
DASHBOARD_WARMUP_ENABLED=true
DASHBOARD_WARMUP_FULL_SCAN=false
DASHBOARD_WARMUP_DELAY_MS=45000
DASHBOARD_WARMUP_INTERVAL_MS=86400000
DASHBOARD_WARMUP_MAX_CONTRATOS=2
DASHBOARD_WARMUP_MAX_SERVICOS=6
DASHBOARD_WARMUP_PAUSE_MS=400

# ─── LLM (opcional) ───
LLM_PROVIDER=
LLM_API_URL=
LLM_MODEL=
LLM_TIMEOUT=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
LMSTUDIO_API_KEY=
